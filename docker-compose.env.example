# Optional overrides for docker-compose.yml.
# Copy to `.env` next to docker-compose.yml (already gitignored) and adjust.
# Everything has a sensible default — the stack runs with no .env at all.

# Public URL of the app (what the browser sees)
APP_URL=http://localhost:8080
WEB_PORT=8080

# Generate once with:
#   docker compose run --rm api php artisan key:generate --show
# If left empty, the API container generates a throwaway key on boot
# (fine for demos; set it for production so keys survive container recreation).
APP_KEY=

APP_ENV=production
APP_DEBUG=false

# Database (used by the `db` service and the `api` service)
DB_DATABASE=api
DB_USERNAME=api
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

# Cookie/Sanctum domains — only needed when serving on a real domain
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080

# Baked into the frontend at build time; empty = same-origin (recommended,
# the bundled nginx proxies /api, /login and /sanctum to the API container)
VITE_API_URL=
